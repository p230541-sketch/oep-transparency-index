# Virtual environment
venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Personal config (contains your email — never commit this)
config.py

# Raw scraped HTML (can be gigabytes; regenerated by the scraper)
data/raw_html/

# Scrape log stays local; data/db.sqlite3 IS committed (0.9 MB sample
# database so the app runs immediately for anyone who clones the repo)
data/scrape_log.sqlite3

# Generated pipeline outputs (rebuilt by build_db.py)
data/*.csv

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store
